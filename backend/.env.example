# Copy this file to .env and fill in your own values.
# .env itself is gitignored - never commit real credentials.

# Which OCR engine to use: "vision" (Google Cloud Vision, best accuracy, needs billing+credentials),
# "qwen2vl" (local GPU, no cloud cost), or "mock" (fake, instant, for testing)
OCR_ENGINE=vision

# Required if OCR_ENGINE=vision. Absolute path to your service account JSON key file.
# NEVER commit this file or share it - it's a password.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-credentials.json

# Only used if OCR_ENGINE=qwen2vl. 2B fits a free Colab T4. Bump to 7B only if you have 16GB+ VRAM.
QWEN2VL_MODEL_NAME=Qwen/Qwen2-VL-2B-Instruct

# Set to false before a real demo/defense or any deployment - shows generic
# error messages to the client instead of full technical detail (NFR-09).
# Keep as true during your own local development, it's genuinely useful for debugging.
DEBUG=true

